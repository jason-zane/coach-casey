# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — the LLM provider for every surface (lib/llm/anthropic.ts).
# Required for real model calls; without it the app serves deterministic mocks
# (or set LLM_MODE=mock explicitly). The model is chosen by LLM_MODELS below.
OPENROUTER_API_KEY=

# LLM_MODELS — ordered, comma-separated list of OpenRouter model slugs. The
# first is the default for every surface; the rest are fallbacks tried in order
# on a transient failure. Every entry must be in MODEL_REGISTRY in
# lib/llm/anthropic.ts (the allowlist) or the app refuses to start. Unset =
# the registry default (deepseek/deepseek-v4-flash). Example:
#   LLM_MODELS=deepseek/deepseek-v4-flash,anthropic/claude-haiku-4.5
# Note: only Claude models honour prompt caching; DeepSeek's cache usage logs 0.
LLM_MODELS=

# ANTHROPIC_API_KEY / OPENAI_API_KEY — no longer used directly; all model
# traffic goes through OpenRouter. Kept here only as a reminder; safe to remove.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Strava
# Modes:
#   live: full OAuth flow. Requires STRAVA_CLIENT_ID + STRAVA_CLIENT_SECRET
#           and the app's Authorization Callback Domain matching the deploy URL.
#   dev: single-user bootstrap from pasted tokens (no OAuth, no callback
#           domain needed). Uses STRAVA_DEV_ACCESS_TOKEN + STRAVA_DEV_REFRESH_TOKEN.
#           Get both from https://www.strava.com/settings/api (My API Application).
#   mock: canned 10-week fixture. No Strava call. Default if unset.
STRAVA_MODE=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_DEV_ACCESS_TOKEN=
STRAVA_DEV_REFRESH_TOKEN=
STRAVA_DEV_EXPIRES_AT=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_EVENT_SECRET=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Stripe (test mode keys initially)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Resend. Send-scoped key from resend.com/api-keys. coachcasey.app is a
# verified sending domain. This key doubles as the SMTP password for Supabase
# auth emails (host smtp.resend.com, port 465, user "resend") — see
# scripts/configure-supabase-smtp.mts. NOTIFY_FROM / NOTIFY_TO are optional
# overrides for founder-alert emails; both default to hello@coachcasey.app
# (see lib/notify.ts).
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=

# App config
NEXT_PUBLIC_APP_URL=
NODE_ENV=
LLM_MODE=  # 'real' | 'mock': see engineering-foundation.md §9

# Early-access gate (lib/auth/invite.ts). While OPEN_SIGNUP is anything but
# "true", creating an account requires the invite code, shared as
# https://www.coachcasey.app/signup?code=THECODE. Unset code = signup closed
# to everyone (fail-closed); existing users still sign in. Flipping
# OPEN_SIGNUP=true is the single switch that opens signup everywhere: the
# signup page, the email flow, and Google sign-in.
SIGNUP_ACCESS_CODE=
OPEN_SIGNUP=

# Cron authorization. Vercel sets `Authorization: Bearer $CRON_SECRET` on
# scheduled invocations of routes in vercel.json's `crons` array. Generate
# with e.g. `openssl rand -hex 32`. Required in production.
CRON_SECRET=

# Admin allowlist. Comma-separated emails that can reach /app/admin and
# the admin server actions (toggling is_test_user, retroactively triggering
# weekly reviews, etc.). Match is case-insensitive against the auth user
# email. Empty / unset = nobody.
ADMIN_EMAILS=

# Web Push (VAPID). Generate once with:
#   npx web-push generate-vapid-keys
# Paste the resulting keys here (and into Vercel env). The public key is
# duplicated in NEXT_PUBLIC_VAPID_PUBLIC_KEY because the browser-side
# subscribe call needs it. VAPID_SUBJECT must be a `mailto:` URL the push
# service can use to contact you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:hello@coachcasey.app
